{
  "extends": "@shared/tsconfig/node.json",
  "compilerOptions": {
    "lib": ["ES2020"],
    "outDir": "./dist",
    "declaration": true,
    "declarationDir": "./dist",
    "ignoreDeprecations": "5.0",
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["src/**/*", "scripts/**/*"],
  "exclude": ["src/**/*.test.ts", "src/**/*.spec.ts"]
}
