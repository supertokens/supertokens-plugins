{
  "name": "@supertokens-plugins/rownd-nodejs",
  "version": "0.6.10",
  "description": "Rownd User Migration Plugin for SuperTokens",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "rownd-nodejs": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsup",
    "cli": "npm run build && node dist/cli.js",
    "lint": "eslint ./src --ext .ts",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "TEST_MODE=testing vitest run --pool=forks"
  },
  "keywords": [
    "supertokens",
    "rownd",
    "migration",
    "plugin"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@rownd/node": "^3.0.4",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "supertokens-node": ">=23.0.0"
  },
  "devDependencies": {
    "@shared/eslint": "*",
    "@shared/nodejs": "*",
    "@shared/tsconfig": "*",
    "@types/node": "^20.0.0",
    "eslint": "^8.57.0",
    "testcontainers": "^10.7.1",
    "tsup": "^8.0.2",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "vitest": "^1.3.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
